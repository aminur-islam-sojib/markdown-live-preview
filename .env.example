# Supabase Project Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
# Modern Supabase projects use publishable keys (sb_publishable_...), legacy projects use anon keys
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
